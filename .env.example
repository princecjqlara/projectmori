# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
DATABASE_URL=
DATABASE_POOL_URL=
DIRECT_DATABASE_URL=
# Optional Supabase CLI personal access token (sbp_...), not the API secret key.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
APP_URL=http://127.0.0.1:3000
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v27.0
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# Enable only after confirming the app/page is eligible for Meta's ad-opened 7-day window.
FACEBOOK_AD_WINDOW_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
# Jev via OpenRouter (the key is server-only).
JEV_PROVIDER=openrouter
OPENROUTER_API_KEY=
JEV_API_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.14
# Optional direct TypeSafe provider: set JEV_PROVIDER=typesafe, use the TypeSafe
# endpoint https://api.typesafe.ai/v1/systemone and JEV_MODEL=jev-latest.
JEV_API_KEY=
# Optional hybrid vector retrieval; without this, indexed full-text RAG works.
EMBEDDING_API_KEY=
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_MODEL=text-embedding-3-small
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
